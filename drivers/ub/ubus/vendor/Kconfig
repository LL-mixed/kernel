menu "UB vendor drivers"
	depends on UB_UBUS

config UB_HISI_UBUS
	tristate "hisilicon ubus"
	depends on UB_UBUS_BUS
	depends on UB_UBUS_USI
	default y
	help
	  This option enables the HiSilicon ubus vendor implementation.
	  For QEMU/simulation environments that rely on vendor private control
	  messages, keep this enabled as built-in.
	  Select 'M' only when you intentionally want a loadable split.

endmenu
